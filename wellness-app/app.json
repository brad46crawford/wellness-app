{
  "expo": {
    "name": "Wellness Circle",
    "slug": "wellness-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#121214"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellnesscircle.app"
    },
    "android": {
      "package": "com.wellnesscircle.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wellness Circle uses your photos to let you share proof of completing a goal with your group.",
          "cameraPermission": "Wellness Circle uses your camera to let you snap a photo when you complete a goal."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
