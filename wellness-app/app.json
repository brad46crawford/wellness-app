{
  "expo": {
    "name": "Ascera",
    "slug": "ascera",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#121214"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellnesscircle.app"
    },
    "android": {
      "package": "com.wellnesscircle.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
